@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("Role");
    var email = Context.Session.GetString("Email");
    var loggedIn = !string.IsNullOrEmpty(Context.Session.GetString("Token"));
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string a) => (ctrl == c && act == a) ? "active" : "";
    var full = ViewData["FullWidth"] as bool? == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="rd-nav">
        <div class="rd-nav-inner">
            <a class="rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>

            <nav class="rd-links">
                @if (role == "Organiser")
                {
                    <a class="@Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                    <a class="@Active("Organiser", "Events")" asp-controller="Organiser" asp-action="Events">My Events</a>
                    <a class="@Active("Organiser", "Categories")" asp-controller="Organiser" asp-action="Categories">Categories</a>
                    <a class="@Active("Organiser", "Enrolments")" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a>
                    <a class="@Active("Organiser", "Results")" asp-controller="Organiser" asp-action="Results">Results</a>
                    <a class="@Active("Profile", "Index")" asp-controller="Profile" asp-action="Index">Profile</a>
                }
                else if (role == "Participant")
                {
                    <a class="@Active("Participant", "Events")" asp-controller="Participant" asp-action="Events">Events</a>
                    <a class="@Active("Participant", "MyEnrolments")" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a>
                    <a class="@Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My Results</a>
                    <a class="@Active("Profile", "Index")" asp-controller="Profile" asp-action="Index">Profile</a>
                }
            </nav>

            <div class="rd-user">
                @if (loggedIn)
                {
                    <span class="who">@email (@role)</span>
                    <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="rd-link-plain" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-raceday btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </header>

    <main class="rd-main">
        @if (full)
        {
            @RenderBody()
        }
        else
        {
            <div class="container-xl py-4">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="rd-footer">
        &copy; 2026 RaceDay. Run. Walk. Cycle.
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>