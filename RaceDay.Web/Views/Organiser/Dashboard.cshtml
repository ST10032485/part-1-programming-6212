@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var email = Context.Session.GetString("Email");
}

<div class="page-header">
    <div>
        <h2>Organiser Dashboard</h2>
        <div class="sub">Signed in as @email</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CreateEvent" class="btn btn-raceday">+ New Event</a>
        <a asp-action="Results" class="btn btn-outline-dark">Enter Results</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="value">@Model.TotalEvents</div>
            <div class="label">Total events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="value">@Model.UpcomingEvents</div>
            <div class="label">Upcoming events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="value">@Model.TotalEnrolments</div>
            <div class="label">Total enrolments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="value" style="font-size:1.4rem;">
                @(Model.NextEvent != null ? Model.NextEvent.EventDate.ToString("dd MMM yyyy") : "None")
            </div>
            <div class="label">Next event</div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">Your events</div>

    @if (!Model.Rows.Any())
    {
        <div class="p-4">
            <div class="alert alert-info mb-0">
                You have not created any events yet.
                <a asp-action="CreateEvent">Create your first event</a>.
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>City</th>
                        <th>Status</th>
                        <th>Enrolments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        var pill = r.Event.Status.ToLower() switch
                        {
                            "upcoming" => "pill-upcoming",
                            "completed" => "pill-completed",
                            _ => "pill-cancelled"
                        };
                        <tr>
                            <td class="fw-semibold">@r.Event.Title</td>
                            <td>@r.Event.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@r.Event.City</td>
                            <td><span class="pill @pill">@r.Event.Status</span></td>
                            <td>@r.EnrolmentCount</td>
                            <td class="text-end">
                                <a asp-action="EventEnrolments" asp-route-id="@r.Event.EventId"
                                   class="btn btn-sm btn-outline-dark">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>