@model ManageCategoriesViewModel
@{
    ViewData["Title"] = "Event Categories";
}

<h2>@Model.Event.Title</h2>
<p class="text-muted">@Model.Event.EventDate.ToString("dd MMM yyyy") | @Model.Event.City</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h4>Current categories</h4>
@if (!Model.Event.Categories.Any())
{
    <div class="alert alert-info">No categories on this event yet.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>Category</th><th>Entry fee</th><th>Max participants</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Event.Categories)
            {
                <tr>
                    <td>@c.CategoryName</td>
                    <td>@("R" + c.EntryFee.ToString("0.00"))</td>
                    <td>@c.MaxParticipants</td>
                    <td>
                        <form asp-action="RemoveCategoryFromEvent" asp-route-id="@Model.Event.EventId"
                              asp-route-categoryId="@c.CategoryId" method="post"
                              onsubmit="return confirm('Remove this category?');">
                            <button class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h4 class="mt-4">Add a category</h4>
@if (!Model.AllCategories.Any())
{
    <div class="alert alert-info">
        There are no categories yet.
        <a asp-action="CreateCategory">Create one first</a>.
    </div>
}
else
{
    <form asp-action="AddCategoryToEvent" asp-route-id="@Model.Event.EventId" method="post" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Category</label>
            <select name="CategoryId" class="form-select" required>
                @foreach (var c in Model.AllCategories)
                {
                    <option value="@c.CategoryId">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Entry fee (R)</label>
            <input name="EntryFee" type="number" step="0.01" min="0" value="0" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Max participants</label>
            <input name="MaxParticipants" type="number" min="1" value="100" class="form-control" required />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-raceday w-100">Add</button>
        </div>
        @Html.AntiForgeryToken()
    </form>
}

<div class="mt-3">
    <a asp-action="CreateCategory" class="btn btn-link">Create a new category</a>
    <a asp-action="Categories" class="btn btn-link">Back to events</a>
</div>