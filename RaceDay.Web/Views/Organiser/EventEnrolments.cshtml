@model List<EnrolmentItem>
@{
    ViewData["Title"] = "Event Enrolments";
}

<h2>@ViewBag.EventTitle</h2>
<p class="text-muted">Total enrolments: @Model.Count</p>

@if (ViewBag.LoadError != null)
{
    <div class="alert alert-danger">@ViewBag.LoadError</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Nobody has enrolled for this event yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Bib</th>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Enrolled on</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    var cls = e.Status.ToLower() switch
                    {
                        "confirmed" => "badge-confirmed",
                        "pending" => "badge-pending",
                        "cancelled" => "badge-cancelled",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td>@e.BibNumber</td>
                        <td>@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @cls">@e.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Enrolments" class="btn btn-link">Back to events</a>