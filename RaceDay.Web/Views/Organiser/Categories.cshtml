@model List<EventItem>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories</h2>
    <a asp-action="CreateCategory" class="btn btn-raceday">+ New Category</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p class="text-muted">Pick an event to manage its categories.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Create an event first, then you can add categories to it.</div>
}
else
{
    <div class="list-group">
        @foreach (var e in Model)
        {
            <a asp-action="ManageCategories" asp-route-id="@e.EventId"
               class="list-group-item list-group-item-action d-flex justify-content-between">
                <span>@e.Title <small class="text-muted">(@e.EventDate.ToString("dd MMM yyyy"))</small></span>
                <span>Manage &rarr;</span>
            </a>
        }
    </div>
}