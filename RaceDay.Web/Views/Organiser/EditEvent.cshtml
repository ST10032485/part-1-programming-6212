@model EventFormModel
@{
    ViewData["Title"] = "New Event";
}

<div class="col-md-7 mx-auto">
    <h2>New Event</h2>

    <form asp-action="EditEvent" asp-route-id="@ViewBag.EventId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Venue" class="form-label"></label>
                <input asp-for="Venue" class="form-control" />
                <span asp-validation-for="Venue" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="RegistrationDeadline" class="form-label"></label>
                <input asp-for="RegistrationDeadline" type="date" class="form-control" />
                <span asp-validation-for="RegistrationDeadline" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
        </div>

        <button class="btn btn-raceday">Create Event</button>
        <a asp-action="Events" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}