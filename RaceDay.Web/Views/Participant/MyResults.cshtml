@model List<MyResultRow>
@{
    ViewData["Title"] = "My Results";
}

<h2>My Results</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No results yet. Your results appear here after an event finishes.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Result.EventTitle</td>
                        <td>@(r.EventDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td>@r.Result.CategoryName</td>
                        <td>@(r.Result.FinishTime?.ToString(@"hh\:mm\:ss") ?? "-")</td>
                        <td>
                            @if (r.Result.Status != "Finished")
                            {
                                @r.Result.Status
                            }
                            else if (r.Result.Position.HasValue)
                            {
                                @($"{r.Result.Position} out of {r.TotalFinishers}")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}