@model List<EventItem>
@{
    ViewData["Title"] = "Events";
    var email = Context.Session.GetString("Email");
}

<div class="page-header">
    <div>
        <h2>Upcoming Events</h2>
        <div class="sub">Welcome, @email. Find your next run, walk or cycle.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MyEnrolments" class="btn btn-outline-dark">My Enrolments</a>
        <a asp-action="MyResults" class="btn btn-outline-dark">My Results</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="filter-bar">
    <div class="row g-2">
        <div class="col-md-4">
            <input name="city" class="form-control" placeholder="City" value="@ViewBag.City" />
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(ViewBag.Type == "Run")">Run</option>
                <option value="Walk" selected="@(ViewBag.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(ViewBag.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-3">
            <input name="date" type="date" class="form-control" value="@ViewBag.Date" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-raceday">Filter</button>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No events match your search.</div>
}
else
{
    <div class="row g-3">
        @foreach (var e in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="event-card type-@e.EventType.ToLower()">
                    <div class="body">
                        <div class="type-tag">@e.EventType</div>
                        <h5>@e.Title</h5>
                        <div class="meta">@e.EventDate.ToString("dd MMM yyyy") | @e.City</div>
                        <span class="chip">@e.DistanceKm km</span>
                    </div>
                    <div class="foot">
                        <a asp-action="EventDetails" asp-route-id="@e.EventId"
                           class="btn btn-raceday w-100">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}